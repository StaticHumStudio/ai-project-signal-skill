{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Demand Signal",
  "description": "One unmet-software-demand signal produced by a sourcing pass. A signals file is a JSON array of 1 to 10 of these objects. Every source requires a verifiable URL, platform, brief quote, and real publication date. Engagement is optional for recent sources and required by the rubric when an older source needs proof of current activity.",
  "type": "object",
  "required": ["title", "summary", "sources", "landscape", "category", "difficulty", "demand_strength"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "platform", "quote", "date"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "platform": { "type": "string", "minLength": 1 },
          "quote": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "engagement": { "type": "string" }
        }
      }
    },
    "landscape": {
      "type": "object",
      "required": ["existing_solutions", "landscape_summary"],
      "additionalProperties": false,
      "properties": {
        "existing_solutions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "url", "gap"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "minLength": 1 },
              "gap": { "type": "string", "minLength": 1 }
            }
          }
        },
        "landscape_summary": { "type": "string", "minLength": 1 }
      }
    },
    "category": { "type": "string", "minLength": 1 },
    "difficulty": {
      "type": "string",
      "minLength": 1,
      "description": "How hard this is to build. Free-form; common values: weekend_hack, weekend_project, real_project, venture_scale (or simply easy, medium, hard)."
    },
    "demand_strength": {
      "type": "string",
      "minLength": 1,
      "description": "How strong the evidenced demand is. Free-form; common values: early, single_request, multiple_requests, trending, building, moderate, strong."
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "builder_note": { "type": "string" }
  }
}
