---
import SignalLayout from '../../layouts/SignalLayout.astro';
import SignalCard from '../../components/SignalCard.astro';
import SignalDivider from '../../components/SignalDivider.astro';
import { getCategoryEntries, getTotalSignals } from '../../utils/signals';

export function getStaticPaths() {
  const totalSignals = getTotalSignals();

  return getCategoryEntries().map(({ label, slug, signals }) => ({
    params: { slug },
    props: { category: label, signals, totalSignals },
  }));
}

const { category, signals, totalSignals } = Astro.props;

const displayName = category.replace(/_/g, ' ');

const metaDescription = `${signals.length} curated software demand signals in the ${displayName} category. Competitive landscape analysis and builder notes for each.`;
---

<SignalLayout
  title={`${displayName} Signals | Signal`}
  description={metaDescription}
  signalCount={totalSignals}
>

  <!-- Page header -->
  <header class="page-header">
    <div class="page-nav">
      <a href="/signal/" class="nav-hub">&larr; back to hub</a>
    </div>
    <h1 class="page-title">{displayName}</h1>
    <div class="page-meta">
      <span class="page-count">{signals.length} signals</span>
    </div>
  </header>

  <SignalDivider />

  <!-- Signal list -->
  <div class="signal-list">
    {signals.map((signal: any) => (
      <SignalCard signal={signal} collapseBuilderNote={true} />
    ))}
  </div>

  <SignalDivider />

  <!-- Bottom nav -->
  <nav class="bottom-nav-bar">
    <a href="/signal/" class="btn btn--primary">back to hub</a>
  </nav>

</SignalLayout>

<style>
  .page-header {
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .page-nav {
    display: flex;
    justify-content: center;
    margin-bottom: 0.75rem;
  }

  .nav-hub {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    color: var(--muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--ghost);
    transition: all 0.2s;
  }

  .nav-hub:hover {
    color: var(--gold-soft);
    border-color: var(--gold-dim);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    font-weight: 600;
    color: var(--text);
    text-transform: capitalize;
    margin-bottom: 0.25rem;
  }

  .page-meta {
    display: flex;
    justify-content: center;
    gap: 1rem;
    align-items: center;
  }

  .page-count {
    font-size: 0.48rem;
    color: var(--gold-dim);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .signal-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .bottom-nav-bar {
    display: flex;
    justify-content: center;
  }
</style>
