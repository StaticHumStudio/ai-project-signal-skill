---
import SignalLayout from '../layouts/SignalLayout.astro';
import SignalCard from '../components/SignalCard.astro';
import SignalDivider from '../components/SignalDivider.astro';
import {
  getAllSignals,
  getCategoryEntries,
  getDateEntries,
  getTotalSignals,
} from '../utils/signals';
import { withBase } from '../utils/paths.js';
import { siteConfig } from '../config.js';

const { brand, meta, hero, seo, sections } = siteConfig;

// Load all published signals.
const allSignals = getAllSignals();
const dateEntries = getDateEntries();
const totalSignals = getTotalSignals();

const allDates = dateEntries.map(d => d.date);
const signalsByDate: Record<string, any[]> = {};
for (const entry of dateEntries) {
  signalsByDate[entry.date] = entry.signals;
}

const categoryEntries = getCategoryEntries()
  .sort((a, b) => b.signals.length - a.signals.length);
const platforms = new Set<string>();
for (const s of allSignals) {
  for (const src of s.sources || []) {
    if (src.platform) platforms.add(src.platform);
  }
}

// Latest signals (from newest file)
const latestDate = allDates[0];
const latestSignals = latestDate ? (signalsByDate[latestDate] || []).slice(0, 5) : [];

// Recent days (last 10)
const recentDays = allDates.slice(0, 10);

// Format date for display
function formatDate(dateStr: string): string {
  const d = new Date(dateStr + 'T12:00:00');
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

function formatDateShort(dateStr: string): string {
  const d = new Date(dateStr + 'T12:00:00');
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}

const siteHome = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": `${brand.name} by ${brand.publisher}`,
      "url": siteHome,
      "description": meta.description,
      "potentialAction": {
        "@type": "ReadAction",
        "target": siteHome,
      },
      "keywords": seo.keywords,
    },
    {
      "@type": "FAQPage",
      "mainEntity": seo.faq.map(entry => ({
        "@type": "Question",
        "name": entry.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": entry.answer,
        },
      })),
    },
  ],
};

---

<SignalLayout
  title={meta.title}
  description={meta.description}
  signalCount={totalSignals}
  jsonLd={jsonLd}
>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-ambient"></div>
    <p class="hero-overline">{hero.overline}</p>
    <h1 class="hero-h1">{hero.headline}<br />{hero.subhead}<span class="cursor"></span></h1>
    <p class="hero-subtitle">{hero.blurb}</p>
    <p class="hero-note">{hero.note}</p>
    <div class="hero-stats">
      <div class="stat">
        <span class="stat-number">{totalSignals}</span>
        <span class="stat-label">{hero.stats.signals}</span>
      </div>
      <div class="stat">
        <span class="stat-number">{dateEntries.length}</span>
        <span class="stat-label">{hero.stats.batches}</span>
      </div>
      <div class="stat">
        <span class="stat-number">{platforms.size}</span>
        <span class="stat-label">{hero.stats.sources}</span>
      </div>
    </div>
  </section>

  <SignalDivider />

  <!-- Browse by Category -->
  {categoryEntries.length > 0 && (
    <section class="section-void">
      <header class="section-header">
        <div class="section-label">
          <span class="prompt">$</span>
          <h2>browse by category</h2>
        </div>
      </header>
      <div class="category-grid">
        {categoryEntries.map(({ label, slug, signals }) => (
          <a href={withBase(`/category/${slug}/`)} class="category-card">
            <span class="category-name">{label.replace(/_/g, ' ')}</span>
            <span class="category-count">{signals.length} signal{signals.length === 1 ? '' : 's'}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <SignalDivider />

  <!-- Example Signals -->
  {latestSignals.length > 0 && (
    <section class="section-void">
      <header class="section-header">
        <div class="section-label">
          <span class="prompt">$</span>
          <h2>example signals</h2>
        </div>
        <p class="section-sub">from {formatDate(latestDate)}</p>
      </header>
      <div class="signal-list">
        {latestSignals.map(signal => (
          <SignalCard
            signal={signal}
            collapseBuilderNote={true}
            compact={false}
          />
        ))}
      </div>
      <div class="section-cta">
        <a href={withBase(`/${latestDate}/`)} class="btn btn--primary">
          view all {signalsByDate[latestDate]?.length || 0}
          {' '}signal{signalsByDate[latestDate]?.length === 1 ? '' : 's'}
          {' '}from {formatDateShort(latestDate)}
        </a>
      </div>
    </section>
  )}

  <SignalDivider />

  <!-- Example Batches -->
  {recentDays.length > 0 && (
    <section class="section-warm">
      <header class="section-header">
        <div class="section-label">
          <span class="prompt">$</span>
          <h2>example batches</h2>
        </div>
      </header>
      <div class="days-list">
        {recentDays.map(date => {
          const signals = signalsByDate[date] || [];
          const previewTitles = signals.slice(0, 3).map(s => s.title);
          return (
            <a href={withBase(`/${date}/`)} class="day-card">
              <div class="day-card-header">
                <span class="day-date">{formatDate(date)}</span>
                <span class="day-count">{signals.length} signal{signals.length === 1 ? '' : 's'}</span>
              </div>
              <div class="day-previews">
                {previewTitles.map(t => (
                  <span class="day-preview-title">{t}</span>
                ))}
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <SignalDivider />

  <!-- Search Intent -->
  <section class="section-warm">
    <header class="section-header">
      <div class="section-label">
        <span class="prompt">$</span>
        <h2>{sections.searchIntent.heading}</h2>
      </div>
    </header>
    <div class="about-content">
      {sections.searchIntent.body.map(paragraph => <p>{paragraph}</p>)}
    </div>
  </section>

  <SignalDivider />

  <!-- About -->
  <section class="section-void">
    <header class="section-header">
      <div class="section-label">
        <span class="prompt">$</span>
        <h2>{sections.about.heading}</h2>
      </div>
    </header>
    <div class="about-content">
      {sections.about.body.map(paragraph => <p>{paragraph}</p>)}
    </div>
  </section>

  <SignalDivider />

  <!-- How Signals Are Sourced -->
  <section class="section-warm">
    <header class="section-header">
      <div class="section-label">
        <span class="prompt">$</span>
        <h2>{sections.process.heading}</h2>
      </div>
    </header>
    <div class="process-grid">
      {sections.process.steps.map(step => (
        <div class="process-step">
          <span class="step-number">{step.number}</span>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </div>
      ))}
    </div>
  </section>

</SignalLayout>

<style>
  /* ── Hero ── */
  .hero {
    text-align: center;
    position: relative;
    overflow: hidden;
    padding: 2rem 0 1rem;
  }

  .hero-ambient {
    position: absolute;
    top: 40%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 420px;
    height: 220px;
    background: radial-gradient(
      ellipse,
      var(--gold-glow) 0%,
      var(--teal-glow) 45%,
      transparent 70%
    );
    pointer-events: none;
    filter: blur(50px);
    opacity: 0.6;
  }

  .hero-overline {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    color: var(--teal);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
    position: relative;
  }

  .hero-h1 {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4vw, 2.6rem);
    font-weight: 400;
    color: var(--text);
    line-height: 1.15;
    letter-spacing: 0.04em;
    margin-bottom: 0.6rem;
    position: relative;
    animation: fadeUp 0.4s ease-out both;
  }

  .hero-subtitle {
    font-size: 0.72rem;
    color: var(--text-dim);
    max-width: 520px;
    margin: 0 auto 0.75rem;
    line-height: 1.6;
    position: relative;
  }

  /* Demo disclaimer. Quieter than the blurb on purpose, but not hidden. */
  .hero-note {
    font-size: 0.62rem;
    color: var(--muted);
    max-width: 520px;
    margin: 0 auto 1.5rem;
    line-height: 1.6;
    position: relative;
  }

  @media (max-width: 700px) {
    .hero-h1 {
      max-width: 18ch;
      margin-inline: auto;
    }
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    gap: 2.5rem;
    position: relative;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--gold);
  }

  .stat-label {
    font-size: 0.48rem;
    color: var(--muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* ── Signal list ── */
  .signal-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .section-cta {
    margin-top: var(--space-md);
    text-align: center;
  }

  /* ── Days list ── */
  .days-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .day-card {
    display: block;
    background: var(--surface-warm);
    padding: 0.7rem 1rem;
    text-decoration: none;
    color: inherit;
    transition: background 0.25s;
    position: relative;
    overflow: hidden;
  }

  .day-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--teal-dim), var(--gold-dim));
    opacity: 0;
    transition: opacity 0.25s;
  }

  .day-card:hover {
    background: var(--elevated);
  }

  .day-card:hover::before {
    opacity: 1;
  }

  .day-card-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.3rem;
  }

  .day-date {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text);
  }

  .day-count {
    font-size: 0.48rem;
    color: var(--gold-dim);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .day-previews {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .day-preview-title {
    font-size: 0.6rem;
    color: var(--text-dim);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── About ── */
  .about-content {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .about-content p {
    font-size: 0.72rem;
    color: var(--text-dim);
    line-height: 1.6;
    max-width: 680px;
  }

  /* ── Process grid ── */
  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3px;
  }

  .process-step {
    background: var(--surface-warm);
    padding: 0.85rem 0.75rem;
  }

  .step-number {
    font-family: var(--font-display);
    font-size: 0.55rem;
    color: var(--teal-dim);
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 0.3rem;
  }

  .process-step h3 {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--gold);
    margin-bottom: 0.25rem;
  }

  .process-step p {
    font-size: 0.6rem;
    color: var(--text-dim);
    line-height: 1.55;
  }

  /* ── Category grid ── */
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 3px;
  }

  .category-card {
    background: var(--surface-warm);
    padding: 0.6rem 0.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-decoration: none;
    color: inherit;
    transition: background 0.25s;
    position: relative;
    overflow: hidden;
  }

  .category-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--teal-dim), var(--gold-dim));
    opacity: 0;
    transition: opacity 0.25s;
  }

  .category-card:hover {
    background: var(--elevated);
  }

  .category-card:hover::before {
    opacity: 1;
  }

  .category-name {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--text);
    text-transform: capitalize;
  }

  .category-count {
    font-size: 0.48rem;
    color: var(--muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* ── Responsive ── */
  @media (max-width: 767px) {
    .hero-stats {
      gap: 1.5rem;
    }

    .process-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .category-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .process-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
